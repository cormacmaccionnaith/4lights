# Copy to .env for local development — server.js loads it via dotenv.
# In production (Railway), set these as service variables instead.

# Postgres. Without it, the app runs in "marketing only" mode (site up,
# account/admin paths return a friendly 503).
DATABASE_URL=postgres://postgres@localhost:5432/fourlights
# DATABASE_SSL=require        # set for external/proxied Postgres connections

# Sessions — use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Seeded admin (created on first boot if it doesn't exist).
ADMIN_EMAIL=cormacmaccionnaith@gmail.com
ADMIN_PASSWORD=set-a-strong-password
# ADMIN_PASSWORD_RESET=1      # set to reset the admin password on next boot

# Public base URL, used for links inside emails.
APP_URL=http://localhost:3000

# Where uploaded documents are stored (a persistent Volume in production).
UPLOAD_DIR=./data/uploads

# MailerSend — optional locally (emails log to the console if unset).
MAILERSEND_API_KEY=
MAIL_FROM=no-reply@swimthe4lights.org
MAIL_FROM_NAME=The Four Lights
